# CLON server configuration
# Copy to .env.local. Never commit real values.

# Required for Live mode
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# At least 32 random characters. It encrypts approvals and paused workflows.
# Changing it invalidates approvals that are still pending.
CLON_APPROVAL_SECRET=

# Canonical deployed origin used for OAuth callbacks (recommended in production)
# CLON_PUBLIC_URL=https://clon.example.com

# Live web research (Life clone)
PARALLEL_API_KEY=
PARALLEL_PROCESSOR=base

# Optional intent classifier. The deterministic planner works without it.
# A model must be explicitly set before the classifier is reported as configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional resilience tuning
CLON_EXTERNAL_TIMEOUT_MS=30000
CLON_RATE_LIMIT_PER_MINUTE=30

# Optional Composio tool pins. Normally CLON discovers the current tool and adapts
# its input schema dynamically. Set these only if your Composio project requires
# a specific tool slug.
# COMPOSIO_TOOL_CALENDAR_LIST=
# COMPOSIO_TOOL_CALENDAR_CREATE=
# COMPOSIO_TOOL_GMAIL_LIST=
# COMPOSIO_TOOL_GMAIL_DRAFT=
